#include<bits/stdc++.h>
using namespace std;

int dfs(int x,int y,int m,int n,vector<vector<int>>&dp){
    if(x==m ||y==n)return 0;
    if(x==m-1 && y==n-1){
        return 1;
    }
    if(dp[x][y]!=-1){
        return dp[x][y];
    }
    //go down;
    dp[x][y]= dfs(x+1,y,m,n,dp)+ dfs(x,y+1,m,n,dp);
    return dp[x][y];

}

int main(){
    int m,n;
    cin>>m>>n;
    vector<vector<int>>dp(m,vector<int>(n,-1));
    cout<<dfs(0,0,m,n,dp);
    return 0;
}